{
  "name": "doveston-health-pulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js --production",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:check": "prisma migrate status",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "user:bootstrap": "node scripts/bootstrap-director.js",
    "test": "node --test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "quality": "npm run lint && npm test"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "argon2": "0.44.0",
    "compression": "^1.8.1",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "globals": "^17.7.0",
    "prisma": "^7.0.0"
  },
  "overrides": {
    "find-my-way": "^9.7.0"
  },
  "description": "Doveston Health Pulse interactive MVP"
}
