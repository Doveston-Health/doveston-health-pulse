generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum IntegrationProvider {
  CLINIKO
  XERO
}

enum IntegrationStatus {
  NOT_CONFIGURED
  CONFIGURED
  CONNECTED
  ERROR
}

enum CredentialType {
  API_KEY
  CLIENT_SECRET
  ACCESS_TOKEN
  REFRESH_TOKEN
}

enum SyncJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum XeroSyncStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum XeroReportType {
  PROFIT_AND_LOSS
  BALANCE_SHEET
  AGED_RECEIVABLES
  AGED_PAYABLES
}

model User {
  id          String      @id @default(uuid()) @db.Uuid
  email       String      @unique
  displayName String      @map("display_name")
  isActive    Boolean     @default(true) @map("is_active")
  passwordHash String?    @map("password_hash")
  lastLoginAt DateTime?   @map("last_login_at")
  failedLoginAttempts Int @default(0) @map("failed_login_attempts")
  lockedUntil DateTime?   @map("locked_until")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  roles       UserRole[]
  auditLogs   AuditLog[]  @relation("AuditLogActor")

  @@map("users")
}

model Session {
  sid    String   @id @db.VarChar(255)
  sess   Json
  expire DateTime @db.Timestamp(6)

  @@index([expire])
  @@map("sessions")
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  userId     String   @db.Uuid @map("user_id")
  roleId     String   @db.Uuid @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Setting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid @map("actor_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  actor       User?    @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Integration {
  id                   String                  @id @default(uuid()) @db.Uuid
  provider             IntegrationProvider     @unique
  displayName          String                  @map("display_name")
  status               IntegrationStatus       @default(NOT_CONFIGURED)
  lastSuccessfulSyncAt DateTime?               @map("last_successful_sync_at")
  lastFailedSyncAt     DateTime?               @map("last_failed_sync_at")
  lastError            String?                 @db.Text @map("last_error")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")
  credentials          IntegrationCredential[]
  syncJobs             SyncJob[]

  @@map("integrations")
}

model IntegrationCredential {
  id             String         @id @default(uuid()) @db.Uuid
  integrationId  String         @db.Uuid @map("integration_id")
  credentialType CredentialType @map("credential_type")
  encryptedValue String         @db.Text @map("encrypted_value")
  expiresAt      DateTime?      @map("expires_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  integration    Integration    @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, credentialType])
  @@map("integration_credentials")
}

model ClinikoBusiness {
  id              String           @id @default(uuid()) @db.Uuid
  clinikoId       String           @unique @map("cliniko_id")
  name            String
  timeZone        String?          @map("time_zone")
  archivedAt      DateTime?        @map("archived_at")
  sourceCreatedAt DateTime?        @map("source_created_at")
  sourceUpdatedAt DateTime?        @map("source_updated_at")
  lastSyncedAt    DateTime         @map("last_synced_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  bookings        ClinikoBooking[]

  @@map("cliniko_businesses")
}

model ClinikoPractitioner {
  id                   String           @id @default(uuid()) @db.Uuid
  clinikoId            String           @unique @map("cliniko_id")
  active               Boolean          @default(true)
  firstName            String           @map("first_name")
  lastName             String           @map("last_name")
  displayName          String           @map("display_name")
  title                String?
  designation          String?
  label                String?
  showInOnlineBookings Boolean?         @map("show_in_online_bookings")
  sourceCreatedAt      DateTime?        @map("source_created_at")
  sourceUpdatedAt      DateTime?        @map("source_updated_at")
  lastSyncedAt         DateTime         @map("last_synced_at")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  bookings             ClinikoBooking[]

  @@index([active])
  @@map("cliniko_practitioners")
}

model ClinikoPatient {
  id                    String                  @id @default(uuid()) @db.Uuid
  clinikoId             String                  @unique @map("cliniko_id")
  firstName             String                  @map("first_name")
  lastName              String                  @map("last_name")
  email                 String?
  mobilePhone           String?                 @map("mobile_phone")
  homePhone             String?                 @map("home_phone")
  acceptedPrivacyPolicy Boolean?                 @map("accepted_privacy_policy")
  archivedAt            DateTime?                @map("archived_at")
  sourceCreatedAt       DateTime?                @map("source_created_at")
  sourceUpdatedAt       DateTime?                @map("source_updated_at")
  lastSyncedAt          DateTime                 @map("last_synced_at")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  bookings              ClinikoBookingPatient[]

  @@index([lastName, firstName])
  @@map("cliniko_patients")
}

model ClinikoBooking {
  id                       String                  @id @default(uuid()) @db.Uuid
  clinikoId                String                  @unique @map("cliniko_id")
  bookingType              String?                 @map("booking_type")
  startsAt                 DateTime                 @map("starts_at")
  endsAt                   DateTime                 @map("ends_at")
  cancelledAt              DateTime?                @map("cancelled_at")
  archivedAt               DateTime?                @map("archived_at")
  deletedAt                DateTime?                @map("deleted_at")
  practitionerId           String?                  @db.Uuid @map("practitioner_id")
  businessId               String?                  @db.Uuid @map("business_id")
  appointmentTypeClinikoId String?                  @map("appointment_type_cliniko_id")
  appointmentTypeName      String?                  @map("appointment_type_name")
  sourceCreatedAt          DateTime?                @map("source_created_at")
  sourceUpdatedAt          DateTime?                @map("source_updated_at")
  lastSyncedAt             DateTime                 @map("last_synced_at")
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")
  practitioner             ClinikoPractitioner?     @relation(fields: [practitionerId], references: [id], onDelete: SetNull)
  business                 ClinikoBusiness?         @relation(fields: [businessId], references: [id], onDelete: SetNull)
  patients                 ClinikoBookingPatient[]

  @@index([startsAt])
  @@index([practitionerId, startsAt])
  @@index([businessId, startsAt])
  @@map("cliniko_bookings")
}

model ClinikoBookingPatient {
  bookingId String         @db.Uuid @map("booking_id")
  patientId String         @db.Uuid @map("patient_id")
  booking   ClinikoBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  patient   ClinikoPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@id([bookingId, patientId])
  @@index([patientId])
  @@map("cliniko_booking_patients")
}

model XeroConnection {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @unique @map("tenant_id")
  tenantName String @map("tenant_name")
  tenantType String? @map("tenant_type")
  externalConnectionId String? @map("external_connection_id")
  isActive Boolean @default(false) @map("is_active")
  connectedAt DateTime @default(now()) @map("connected_at")
  disconnectedAt DateTime? @map("disconnected_at")
  lastSuccessfulSyncAt DateTime? @map("last_successful_sync_at")
  lastAttemptedSyncAt DateTime? @map("last_attempted_sync_at")
  lastSyncStatus XeroSyncStatus? @map("last_sync_status")
  lastSyncErrorCode String? @map("last_sync_error_code")
  lastSyncErrorMessage String? @db.Text @map("last_sync_error_message")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  token XeroOAuthToken?
  organisation XeroOrganisation?
  contacts XeroContact[]
  invoices XeroInvoice[]
  payments XeroPayment[]
  reports XeroReportSnapshot[]
  syncRuns XeroSyncRun[]
  @@index([isActive])
  @@map("xero_connections")
}

model XeroOAuthToken {
  id String @id @default(uuid()) @db.Uuid
  connectionId String @unique @db.Uuid @map("connection_id")
  encryptedAccessToken String @db.Text @map("encrypted_access_token")
  encryptedRefreshToken String @db.Text @map("encrypted_refresh_token")
  accessTokenExpiresAt DateTime @map("access_token_expires_at")
  refreshTokenUpdatedAt DateTime @map("refresh_token_updated_at")
  tokenVersion Int @default(1) @map("token_version")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  connection XeroConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  @@map("xero_oauth_tokens")
}

model XeroOrganisation {
  id String @id @default(uuid()) @db.Uuid
  connectionId String @unique @db.Uuid @map("connection_id")
  tenantId String @unique @map("tenant_id")
  legalName String? @map("legal_name")
  organisationName String @map("organisation_name")
  baseCurrency String @map("base_currency")
  countryCode String? @map("country_code")
  financialYearEndDay Int? @map("financial_year_end_day")
  financialYearEndMonth Int? @map("financial_year_end_month")
  organisationType String? @map("organisation_type")
  sourceUpdatedAt DateTime? @map("source_updated_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  connection XeroConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  @@map("xero_organisations")
}

model XeroContact {
  id String @id @default(uuid()) @db.Uuid
  connectionId String @db.Uuid @map("connection_id")
  contactId String @map("contact_id")
  name String
  contactStatus String? @map("contact_status")
  isCustomer Boolean @default(false) @map("is_customer")
  isSupplier Boolean @default(false) @map("is_supplier")
  email String?
  accountsReceivableTaxType String? @map("accounts_receivable_tax_type")
  accountsPayableTaxType String? @map("accounts_payable_tax_type")
  sourceUpdatedAt DateTime? @map("source_updated_at")
  archivedAt DateTime? @map("archived_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  connection XeroConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  invoices XeroInvoice[]
  @@unique([connectionId, contactId])
  @@index([connectionId, name])
  @@map("xero_contacts")
}

model XeroInvoice {
  id String @id @default(uuid()) @db.Uuid
  connectionId String @db.Uuid @map("connection_id")
  invoiceId String @map("invoice_id")
  contactId String? @db.Uuid @map("contact_id")
  invoiceNumber String? @map("invoice_number")
  reference String?
  invoiceType String @map("invoice_type")
  status String
  currencyCode String @map("currency_code")
  invoiceDate DateTime @db.Date @map("invoice_date")
  dueDate DateTime? @db.Date @map("due_date")
  subtotal Decimal? @db.Decimal(19,4)
  totalTax Decimal? @db.Decimal(19,4) @map("total_tax")
  total Decimal @db.Decimal(19,4)
  amountDue Decimal @db.Decimal(19,4) @map("amount_due")
  amountPaid Decimal @db.Decimal(19,4) @map("amount_paid")
  amountCredited Decimal @db.Decimal(19,4) @map("amount_credited")
  fullyPaidOnDate DateTime? @db.Date @map("fully_paid_on_date")
  sourceUpdatedAt DateTime? @map("source_updated_at")
  archivedAt DateTime? @map("archived_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  connection XeroConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  contact XeroContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  payments XeroPayment[]
  @@unique([connectionId, invoiceId])
  @@index([connectionId, invoiceType, invoiceDate])
  @@index([connectionId, dueDate, amountDue])
  @@map("xero_invoices")
}

model XeroPayment {
  id String @id @default(uuid()) @db.Uuid
  connectionId String @db.Uuid @map("connection_id")
  paymentId String @map("payment_id")
  invoiceId String? @db.Uuid @map("invoice_id")
  paymentDate DateTime @db.Date @map("payment_date")
  amount Decimal @db.Decimal(19,4)
  status String?
  paymentType String? @map("payment_type")
  sourceUpdatedAt DateTime? @map("source_updated_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  connection XeroConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  invoice XeroInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  @@unique([connectionId, paymentId])
  @@index([connectionId, paymentDate])
  @@map("xero_payments")
}

model XeroReportSnapshot {
  id String @id @default(uuid()) @db.Uuid
  connectionId String @db.Uuid @map("connection_id")
  tenantId String @map("tenant_id")
  reportType XeroReportType @map("report_type")
  periodStart DateTime? @db.Date @map("period_start")
  periodEnd DateTime? @db.Date @map("period_end")
  asAtDate DateTime? @db.Date @map("as_at_date")
  basis String?
  currencyCode String? @map("currency_code")
  metrics Json
  payloadVersion Int @default(1) @map("payload_version")
  generatedAt DateTime? @map("generated_at")
  syncedAt DateTime @default(now()) @map("synced_at")
  connection XeroConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  @@index([connectionId, reportType, syncedAt])
  @@map("xero_report_snapshots")
}

model XeroSyncRun {
  id String @id @default(uuid()) @db.Uuid
  connectionId String @db.Uuid @map("connection_id")
  tenantId String @map("tenant_id")
  syncType String @map("sync_type")
  status XeroSyncStatus @default(PENDING)
  stage String?
  startedAt DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  recordsFetched Int @default(0) @map("records_fetched")
  recordsPersisted Int @default(0) @map("records_persisted")
  errorCode String? @map("error_code")
  errorMessage String? @db.Text @map("error_message")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  connection XeroConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  @@index([connectionId, status, createdAt])
  @@map("xero_sync_runs")
}

model SyncJob {
  id            String        @id @default(uuid()) @db.Uuid
  integrationId String?       @db.Uuid @map("integration_id")
  jobType       String        @map("job_type")
  status        SyncJobStatus @default(PENDING)
  startedAt     DateTime?     @map("started_at")
  completedAt   DateTime?     @map("completed_at")
  errorMessage  String?       @db.Text @map("error_message")
  metadata      Json?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  integration   Integration?  @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@index([integrationId])
  @@index([status, createdAt])
  @@map("sync_jobs")
}
