generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum IntegrationProvider {
  CLINIKO
  XERO
}

enum IntegrationStatus {
  NOT_CONFIGURED
  CONFIGURED
  CONNECTED
  ERROR
}

enum CredentialType {
  API_KEY
  CLIENT_SECRET
  ACCESS_TOKEN
  REFRESH_TOKEN
}

enum SyncJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model User {
  id          String      @id @default(uuid()) @db.Uuid
  email       String      @unique
  displayName String      @map("display_name")
  isActive    Boolean     @default(true) @map("is_active")
  passwordHash String?    @map("password_hash")
  lastLoginAt DateTime?   @map("last_login_at")
  failedLoginAttempts Int @default(0) @map("failed_login_attempts")
  lockedUntil DateTime?   @map("locked_until")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  roles       UserRole[]
  auditLogs   AuditLog[]  @relation("AuditLogActor")

  @@map("users")
}

model Session {
  sid    String   @id @db.VarChar(255)
  sess   Json
  expire DateTime @db.Timestamp(6)

  @@index([expire])
  @@map("sessions")
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  userId     String   @db.Uuid @map("user_id")
  roleId     String   @db.Uuid @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Setting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid @map("actor_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  actor       User?    @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Integration {
  id                   String                  @id @default(uuid()) @db.Uuid
  provider             IntegrationProvider     @unique
  displayName          String                  @map("display_name")
  status               IntegrationStatus       @default(NOT_CONFIGURED)
  lastSuccessfulSyncAt DateTime?               @map("last_successful_sync_at")
  lastFailedSyncAt     DateTime?               @map("last_failed_sync_at")
  lastError            String?                 @db.Text @map("last_error")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")
  credentials          IntegrationCredential[]
  syncJobs             SyncJob[]

  @@map("integrations")
}

model IntegrationCredential {
  id             String         @id @default(uuid()) @db.Uuid
  integrationId  String         @db.Uuid @map("integration_id")
  credentialType CredentialType @map("credential_type")
  encryptedValue String         @db.Text @map("encrypted_value")
  expiresAt      DateTime?      @map("expires_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  integration    Integration    @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, credentialType])
  @@map("integration_credentials")
}

model ClinikoBusiness {
  id              String           @id @default(uuid()) @db.Uuid
  clinikoId       String           @unique @map("cliniko_id")
  name            String
  timeZone        String?          @map("time_zone")
  archivedAt      DateTime?        @map("archived_at")
  sourceCreatedAt DateTime?        @map("source_created_at")
  sourceUpdatedAt DateTime?        @map("source_updated_at")
  lastSyncedAt    DateTime         @map("last_synced_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  bookings        ClinikoBooking[]

  @@map("cliniko_businesses")
}

model ClinikoPractitioner {
  id                   String           @id @default(uuid()) @db.Uuid
  clinikoId            String           @unique @map("cliniko_id")
  active               Boolean          @default(true)
  firstName            String           @map("first_name")
  lastName             String           @map("last_name")
  displayName          String           @map("display_name")
  title                String?
  designation          String?
  label                String?
  showInOnlineBookings Boolean?         @map("show_in_online_bookings")
  sourceCreatedAt      DateTime?        @map("source_created_at")
  sourceUpdatedAt      DateTime?        @map("source_updated_at")
  lastSyncedAt         DateTime         @map("last_synced_at")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  bookings             ClinikoBooking[]

  @@index([active])
  @@map("cliniko_practitioners")
}

model ClinikoPatient {
  id                    String                  @id @default(uuid()) @db.Uuid
  clinikoId             String                  @unique @map("cliniko_id")
  firstName             String                  @map("first_name")
  lastName              String                  @map("last_name")
  email                 String?
  mobilePhone           String?                 @map("mobile_phone")
  homePhone             String?                 @map("home_phone")
  acceptedPrivacyPolicy Boolean?                 @map("accepted_privacy_policy")
  archivedAt            DateTime?                @map("archived_at")
  sourceCreatedAt       DateTime?                @map("source_created_at")
  sourceUpdatedAt       DateTime?                @map("source_updated_at")
  lastSyncedAt          DateTime                 @map("last_synced_at")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  bookings              ClinikoBookingPatient[]

  @@index([lastName, firstName])
  @@map("cliniko_patients")
}

model ClinikoBooking {
  id                       String                  @id @default(uuid()) @db.Uuid
  clinikoId                String                  @unique @map("cliniko_id")
  bookingType              String?                 @map("booking_type")
  startsAt                 DateTime                 @map("starts_at")
  endsAt                   DateTime                 @map("ends_at")
  cancelledAt              DateTime?                @map("cancelled_at")
  archivedAt               DateTime?                @map("archived_at")
  deletedAt                DateTime?                @map("deleted_at")
  practitionerId           String?                  @db.Uuid @map("practitioner_id")
  businessId               String?                  @db.Uuid @map("business_id")
  appointmentTypeClinikoId String?                  @map("appointment_type_cliniko_id")
  appointmentTypeName      String?                  @map("appointment_type_name")
  sourceCreatedAt          DateTime?                @map("source_created_at")
  sourceUpdatedAt          DateTime?                @map("source_updated_at")
  lastSyncedAt             DateTime                 @map("last_synced_at")
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")
  practitioner             ClinikoPractitioner?     @relation(fields: [practitionerId], references: [id], onDelete: SetNull)
  business                 ClinikoBusiness?         @relation(fields: [businessId], references: [id], onDelete: SetNull)
  patients                 ClinikoBookingPatient[]

  @@index([startsAt])
  @@index([practitionerId, startsAt])
  @@index([businessId, startsAt])
  @@map("cliniko_bookings")
}

model ClinikoBookingPatient {
  bookingId String         @db.Uuid @map("booking_id")
  patientId String         @db.Uuid @map("patient_id")
  booking   ClinikoBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  patient   ClinikoPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@id([bookingId, patientId])
  @@index([patientId])
  @@map("cliniko_booking_patients")
}

model SyncJob {
  id            String        @id @default(uuid()) @db.Uuid
  integrationId String?       @db.Uuid @map("integration_id")
  jobType       String        @map("job_type")
  status        SyncJobStatus @default(PENDING)
  startedAt     DateTime?     @map("started_at")
  completedAt   DateTime?     @map("completed_at")
  errorMessage  String?       @db.Text @map("error_message")
  metadata      Json?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  integration   Integration?  @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@index([integrationId])
  @@index([status, createdAt])
  @@map("sync_jobs")
}
